# Bootstrap the strike ci/cd tool: stage_0 of the reproducibility proof in
# docs/ADR-009-bootstrap-reproducibility-proof.md.
#
# Stage 0 is "dirty" in one aspect: it uses a legacy Containerfile. It runs no
# shell. The builder passes the pinned commit to git through git's
# configuration from the environment, which ENV expands from the build
# argument, and fetches in exec form.
#
# Every stage is composed, not pulled
# (docs/ADR-055-hardened-endpoint-development-premise.md, D3): the cgr.dev
# static base, with the Go toolchain and git taken by COPY from cgr.dev images,
# each pinned by its linux/amd64 manifest digest. A cgr.dev Go image is a copy
# source only, and no stage sets GODEBUG.
#
# The builder stage fetches the pinned commit and builds the strike binary.
# The render stage renders the bootstrap lane from its template
# bootstrap/lane.cue, with the fetched commit and the root of the local
# sigstore harness as its two inputs. The last stage is stage_1: a
# digest-pinned static base carrying the binary and the rendered lane, and
# nothing else. stage_1 runs the lane as a sibling of its steps on your
# engine; the lane builds stage_2, builds it again with the cache bypassed as
# stage_3, and deploys stage_2 to the harness registry only if both are
# byte-identical. No stage runs an engine of its own
# (docs/ADR-055-hardened-endpoint-development-premise.md, D9).
#
# Prerequisites: rootless podman, and the local sigstore harness up from a
# clone of the repository (make -C test/sigstore-local up). The build reads
# the harness root from the clone through the build context named harness.
#
# GIT_COMMIT=<commit-sha> ; podman build -t strike:stage_1 --build-arg GIT_COMMIT=${GIT_COMMIT} --build-context harness=test/sigstore-local/pki https://raw.githubusercontent.com/istr/strike/${GIT_COMMIT}/bootstrap/Containerfile
#
# The run line that executes stage_1 is in README.md, section Bootstrap.
#
FROM cgr.dev/chainguard/static@sha256:939754fefdbdb198356dc3187310417777d4dd8561be000885e224d49a4ce727 AS builder
ARG GIT_COMMIT
COPY --from=cgr.dev/chainguard/go@sha256:806b06607f346ed94cbf0c7e0821502f8a048b22f30bbd9a0e46cc28bfe2146d /usr/lib/go /usr/lib/go
# git's runtime closure and the NSS compat module the static base's
# nsswitch.conf names.
COPY --from=cgr.dev/chainguard/git@sha256:00b30fd8f9e81a575c27b6dd0f8f93055f6761710b5071eaebcd692b83b945a9 /usr/lib/ld-linux-x86-64.so.2 /usr/lib/libc.so.6 /usr/lib/libm.so.6 /usr/lib/libresolv.so.2 /usr/lib/libnss_compat.so.2 /usr/lib/libpcre2-8.so.0 /usr/lib/libz.so.1 /usr/lib/libexpat.so.1 /usr/lib/libcurl.so.4 /usr/lib/libnghttp3.so.9 /usr/lib/libngtcp2_crypto_ossl.so.0 /usr/lib/libngtcp2.so.16 /usr/lib/libnghttp2.so.14 /usr/lib/libidn2.so.0 /usr/lib/libldap.so.2 /usr/lib/liblber.so.2 /usr/lib/libpsl.so.5 /usr/lib/libssl.so.4 /usr/lib/libcrypto.so.4 /usr/lib/libgssapi_krb5.so.2 /usr/lib/libbrotlidec.so.1 /usr/lib/libbrotlienc.so.1 /usr/lib/libbrotlicommon.so.1 /usr/lib/libunistring.so.5 /usr/lib/libsasl2.so.3 /usr/lib/libkrb5.so.3 /usr/lib/libk5crypto.so.3 /usr/lib/libcom_err.so.2 /usr/lib/libkrb5support.so.0 /usr/lib/libkeyutils.so.1 /usr/lib/
COPY --from=cgr.dev/chainguard/git@sha256:00b30fd8f9e81a575c27b6dd0f8f93055f6761710b5071eaebcd692b83b945a9 /usr/bin/git /usr/bin/git
COPY --from=cgr.dev/chainguard/git@sha256:00b30fd8f9e81a575c27b6dd0f8f93055f6761710b5071eaebcd692b83b945a9 /usr/libexec/git-core /usr/libexec/git-core
COPY --from=cgr.dev/chainguard/git@sha256:00b30fd8f9e81a575c27b6dd0f8f93055f6761710b5071eaebcd692b83b945a9 /usr/share/git-core /usr/share/git-core
USER 0
ENV PATH=/usr/lib/go/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin
WORKDIR /src
RUN ["git", "init"]
# ENV expands the build argument, RUN does not: the commit reaches git
# through its configuration from the environment, and the fetch runs in
# exec form. An unknown commit fails the fetch.
ENV GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=remote.origin.url GIT_CONFIG_VALUE_0=https://github.com/istr/strike GIT_CONFIG_KEY_1=remote.origin.fetch GIT_CONFIG_VALUE_1=${GIT_COMMIT}
RUN ["git", "fetch", "--depth", "1", "origin"]
RUN ["git", "checkout", "FETCH_HEAD"]
RUN ["go", "mod", "download"]
RUN ["go", "generate", "./contract"]
ENV CGO_ENABLED=0
RUN ["go", "build", "-trimpath", "-ldflags=-s -w", "-o", "strike", "./cmd/strike"]

FROM builder AS render
COPY --from=builder /src/.git/HEAD /src/bootstrap/input/HEAD
COPY --from=harness caddy-root.crt /src/bootstrap/input/caddy-root.crt
RUN ["go", "tool", "cue", "export", "./bootstrap", "-e", "out", "--out", "yaml", "--outfile", "/src/bootstrap/lane.yaml"]

FROM cgr.dev/chainguard/static@sha256:939754fefdbdb198356dc3187310417777d4dd8561be000885e224d49a4ce727
COPY --from=builder /src/strike /usr/bin/strike
COPY --from=render /src/bootstrap/lane.yaml /bootstrap/lane.yaml
ENTRYPOINT ["/usr/bin/strike"]
CMD ["run", "/bootstrap/lane.yaml"]
