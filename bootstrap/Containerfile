# Bootstrap the strike ci/cd tool: stage_0 of the reproducibility proof in
# docs/ADR-009-bootstrap-reproducibility-proof.md.
#
# Stage 0 is "dirty" in two aspects:
# - it uses a legacy Containerfile
# - it still needs an implicit shell expansion in one of the Containerfile steps
#
# Stage 0 builds the strike binary from the pinned commit and produces the
# stage_1 image with the binary and the pinned tree. stage_1 runs the
# bootstrap lane as a sibling of its steps on the operator's engine: the lane
# builds stage_2, builds it again with the cache bypassed as stage_3, and
# publishes stage_2 only if both are byte-identical. No stage runs an engine
# of its own (docs/ADR-055-hardened-endpoint-development-premise.md, D9); the
# engine-bearing base of the second stage below is retired by the amendment
# of 2026-09-14 to ADR-009.
#
# Prerequisite: you have podman installed on your host.
#
# GIT_COMMIT=<commit-sha> ; podman build -t strike:stage_1 --build-arg GIT_COMMIT=${GIT_COMMIT} https://raw.githubusercontent.com/istr/strike/${GIT_COMMIT}/bootstrap/Containerfile
#
FROM docker.io/library/golang:1.26.10-alpine@sha256:d1f3216ef30257c850cc136ba42a359ccd9d3e75f19b2c276e520c0b4ef327ce AS builder
ARG GIT_COMMIT
RUN ["apk", "add", "--no-cache", "git"]
WORKDIR /src
RUN ["git", "init"]
# We want no-sh. However, we cannot pass GIT_COMMIT to git using ARG/ENV combination.
RUN git fetch --depth 1 https://github.com/istr/strike ${GIT_COMMIT}
RUN ["git", "checkout", "FETCH_HEAD"]
RUN ["go", "mod", "download"]
RUN ["go", "generate", "./contract"]
ENV CGO_ENABLED=0
RUN ["go", "build", "-trimpath", "-ldflags=-s -w", "-o", "strike", "./cmd/strike"]

FROM docker.io/mgoltzsche/podman@sha256:53e4c6d0597bd01afca2355b83d993c4254efce0e64afa0beb3026d38ee27a9d
COPY --from=builder /src /src

RUN rm -f /usr/bin/fuse-overlayfs /usr/bin/libfuse* /usr/local/bin/*fuse*
RUN printf "[storage]\ndriver = \"overlay\"\n" > /etc/containers/storage.conf

WORKDIR /src
ENTRYPOINT ["/src/strike"]
CMD ["run"]
