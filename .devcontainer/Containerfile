# Dev container for the hardened-endpoint premise; see
# docs/ADR-055-hardened-endpoint-development-premise.md.
#
# Transitional: this version does not conform to ADR-055 D3. The Node.js
# runtime comes from a distribution repository and is past upstream end of
# life, and the agent arrives through a Dev Containers feature at a floating
# version. It is the measured baseline the conforming rework starts from,
# not a precedent for either practice.
FROM docker.io/library/golang:1.26.10@sha256:3eca740eb349175cc59f462d409fc324a8239ab3ffdf73d8e63175a041c08b6b
RUN ["apt-get", "update"]
RUN ["apt-get", "install", "-y", "--no-install-recommends", "nodejs", "npm"]
RUN ["go", "install", "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.13.2"]
RUN ["go", "install", "golang.org/x/vuln/cmd/govulncheck@v1.7.0"]
RUN ["useradd", "--create-home", "--uid", "1000", "--user-group", "--shell", "/bin/bash", "dev"]
RUN ["chown", "-R", "dev:dev", "/go"]
USER dev
# Mount point of the strike-claude volume; an empty volume copies this
# directory's ownership on first mount, so the agent's state stays writable.
RUN ["mkdir", "-p", "/home/dev/.claude"]
