# Dev container for the hardened-endpoint premise; see
# docs/ADR-055-hardened-endpoint-development-premise.md.
#
# Transitional: the base image comes from docker.io and has not been measured
# against a cgr.dev image carrying the Go minor go.mod demands and the C
# toolchain the race detector needs (ADR-055 D3). It is not a precedent.
FROM docker.io/library/golang:1.27.3@sha256:5bbe76a31abbe0f1449d7820e550131c020b097c24d3bcfc5ad1231779982c1c AS tools
RUN ["go", "install", "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0"]
RUN ["go", "install", "golang.org/x/vuln/cmd/govulncheck@v1.9.0"]
# The agent's linux-x64 platform package is a self-contained native binary;
# the checksum pins the registry tarball whose sha512 integrity npm publishes.
ADD --checksum=sha256:745e1b196eb475161a185a00f5e1144d7324ec6094e21149eae719fa42481000 https://registry.npmjs.org/@anthropic-ai/claude-code-linux-x64/-/claude-code-linux-x64-2.1.316.tgz /tmp/claude-code.tgz
RUN ["tar", "-xzf", "/tmp/claude-code.tgz", "-C", "/tmp", "package/claude"]

FROM docker.io/library/golang:1.27.3@sha256:5bbe76a31abbe0f1449d7820e550131c020b097c24d3bcfc5ad1231779982c1c
COPY --from=tools /go/bin/golangci-lint /go/bin/govulncheck /go/bin/
COPY --from=tools /tmp/package/claude /usr/local/bin/claude
RUN ["useradd", "--create-home", "--uid", "1000", "--user-group", "--shell", "/bin/bash", "dev"]
USER dev
# Mount point of the strike-claude volume; an empty volume copies this
# directory's ownership on first mount, so the agent's state stays writable.
RUN ["mkdir", "-p", "/home/dev/.claude"]
