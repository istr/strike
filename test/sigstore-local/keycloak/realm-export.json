{
  "realm": "sigstore",
  "enabled": true,
  "accessTokenLifespan": 600,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "sigstore",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "defaultClientScopes": [
        "profile"
      ],
      "protocolMappers": [
        {
          "name": "url",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "url",
            "claim.value": "https://forge.strike.localhost",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "repository",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "repository",
            "claim.value": "istr/strike",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "ref",
            "claim.value": "refs/heads/main",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "sha",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "sha",
            "claim.value": "0000000000000000000000000000000000000000",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "workflow_ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "workflow_ref",
            "claim.value": "istr/strike/bootstrap/lane.cue@refs/heads/main",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "runner_environment",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "runner_environment",
            "claim.value": "self-hosted",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "tester",
      "enabled": true,
      "email": "tester@strike.localhost",
      "emailVerified": true,
      "firstName": "Strike",
      "lastName": "Tester",
      "credentials": [
        {
          "type": "password",
          "value": "tester",
          "temporary": false
        }
      ]
    }
  ]
}
